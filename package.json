    "@mantine/notifications": "^8.3.14",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.19.2",
    "@stripe/stripe-js": "^8.7.0",
    "@tabler/icons-react": "^3.36.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "dayjs": "^1.11.19",
    "leaflet": "^1.9.4",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "postcss": "^8.5.6",
