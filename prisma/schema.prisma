generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // User requested NO sqlite
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

// NextAuth Models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  addresses     Address[]
  dietaryPreferences DietaryOption[]
  pollVotes     PollVote[]
  phoneNumber      String?
  containerBalance Int       @default(0)
  defaultPackaging Packaging @default(CARDBOARD)
  emailMenuWeekly  Boolean   @default(true)
  emailPromo       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum AddressType {
  DOMICILE
  BUREAU
}

model Address {
  id        String      @id @default(cuid())
  label     String      // e.g. "Home", "Office"
  type      AddressType @default(DOMICILE)
  content   String      // e.g. "123 Main St, Apt 4B, Paris"
  details   String?     // e.g. "Code 1234, Etage 2"
  lat       Float?      // Latitude (from BAN autocomplete or migration script)
  lon       Float?      // Longitude
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// App Domain Models

model DeliveryZone {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#228be6") // Hex color for map display
  polygon   Json     // ZonePoint[] = [{ lat: number, lon: number }]
  menus     Menu[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Dish Library (NEW) ────────────────────────────────────────────────────────
// Central repository of reusable dishes. Can be used to populate menus.

model DishLibraryItem {
  id             String          @id @default(cuid())
  name           String
  description    String?
  ingredients    String?
  imageUrl       String?
  category       ItemCategory    @default(MAIN)
  dietaryOptions DietaryOption[]
  spiceLevel     String?
  suggestedPrice Float           @default(0)
  optionGroups   DishOptionGroup[]
  pollOptions    PollOption[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model DishOptionGroup {
  id            String          @id @default(cuid())
  name          String
  isRequired    Boolean         @default(false)
  allowMultiple Boolean         @default(false)
  maxOptions    Int?
  dish          DishLibraryItem @relation(fields: [dishId], references: [id], onDelete: Cascade)
  dishId        String
  options       DishOptionItem[]
}

model DishOptionItem {
  id          String          @id @default(cuid())
  name        String
  description String?
  price       Float           @default(0)
  group       DishOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId     String
}

// ─── Menu & Items (EXISTING STRUCTURE) ────────────────────────────────────────

model Menu {
  id               String        @id @default(cuid())
  date             DateTime      @unique
  locked           Boolean       @default(false) // Manuel admin override
  items            MenuItem[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  orders           Order[]
  deliveryZoneId   String?
  deliveryZone     DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
}

model MenuItem {
  id          String      @id @default(cuid())
  name        String
  description String?
  ingredients String?
  category    ItemCategory @default(MAIN)
  price       Float       @default(0)
  blocked     Boolean     @default(false) // Admin override: masque le plat sans bloquer le menu
  dietaryOptions DietaryOption[]
  spiceLevel  String?     // 'MILD', 'MEDIUM', 'HOT'
  menu        Menu        @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuId      String
  optionGroups OptionGroup[]
  orderItems   OrderItem[]
}

model OptionGroup {
  id          String       @id @default(cuid())
  name        String
  isRequired  Boolean      @default(false)
  allowMultiple Boolean    @default(false)
  maxOptions  Int?
  menuItem    MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  menuItemId  String
  options     OptionItem[]
}

model OptionItem {
  id        String      @id @default(cuid())
  name      String
  description String?
  price     Float       @default(0)
  group     OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
}

enum ItemCategory {
  STARTER
  MAIN
  DESSERT
  DRINK
}

enum DietaryOption {
  VEGETARIAN
  VEGAN
  HALAL
  GLUTEN_FREE
  SPICY
  PROTEIN   // Supplément Protéines (option configurable par menu)
  COMPLETE  // Version Complète (ex: riz complet, pâtes complètes)
}

model Order {
  id              String      @id @default(cuid())
  user            User        @relation(fields: [userId], references: [id])
  userId          String
  menu            Menu        @relation(fields: [menuId], references: [id])
  menuId          String
  items           OrderItem[]
  deliveryAddress String
  deliveryTime    String?
  notes           String?
  dietaryOption   String?
  status          OrderStatus @default(PENDING)
  stripePaymentId String?
  total           Float       @default(0)
  packaging       Packaging   @default(CARDBOARD)
  isReturningContainer Boolean @default(false)
  containersReturnedCount Int @default(0)
  review          OrderReview?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

enum OrderStatus {
  PENDING       // Prise en compte
  IN_KITCHEN    // En cuisine (commandes du jour)
  IN_DELIVERY   // En livraison
  DELIVERED     // Livrée (en attente de paiement)
  PAID          // Livrée et payée
  CANCELLED     // Annulée
}

enum Packaging {
  CARDBOARD
  TUPPERWARE
}

model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  item      MenuItem @relation(fields: [itemId], references: [id])
  itemId    String
  selectedOption String? // Deprecated or simple Note?
  selectedOptions Json?   // Stores complex selections { [groupId]: [optionId, optionId] }
  itemRating      OrderItemRating?
}

// Review models
model OrderReview {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String   @unique
  comment   String?  // Free comment, optional
  itemRatings OrderItemRating[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItemRating {
  id          String      @id @default(cuid())
  review      OrderReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId    String
  orderItem   OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId String      @unique
  rating      Int         // 1 to 5
}

// Global app settings stored as key-value pairs
// Keys are unique strings; values are JSON-encoded (string, bool, number...)
model AppSetting {
  key       String   @id   // e.g. "tupperware_enabled"
  value     String         // JSON-encoded value, e.g. "true" or "false"
  updatedAt DateTime @updatedAt
}

// ─── Polls & Votes ─────────────────────────────────────────────────────────────

enum PollStatus {
  DRAFT  // Non visible par les users
  OPEN   // Votes ouverts
  CLOSED // Votes fermés, résultats visibles
}

enum PollQuestionType {
  RANKED_CHOICE    // L'user peut classer les options (rang 1, 2, 3…) — classement partiel autorisé
  SINGLE_CHOICE    // L'user choisit une seule option
  MULTIPLE_CHOICE  // L'user choisit plusieurs options sans rang
}

model Poll {
  id          String         @id @default(cuid())
  title       String
  description String?
  status      PollStatus     @default(DRAFT)
  openAt      DateTime?      // Ouverture automatique (optionnel)
  closeAt     DateTime?      // Fermeture automatique (optionnel)
  questions   PollQuestion[]
  votes       PollVote[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model PollQuestion {
  id       String           @id @default(cuid())
  poll     Poll             @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId   String
  text     String
  type     PollQuestionType @default(RANKED_CHOICE)
  order    Int              @default(0)
  options  PollOption[]
  answers  PollAnswer[]
}

model PollOption {
  id                String           @id @default(cuid())
  question          PollQuestion     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId        String
  text              String
  imageUrl          String?
  order             Int              @default(0)
  // Lien optionnel vers la bibliothèque de plats (pour les sondages de menus)
  dishLibraryItem   DishLibraryItem? @relation(fields: [dishLibraryItemId], references: [id], onDelete: SetNull)
  dishLibraryItemId String?
  selections        PollAnswerSelection[]
}

// Un vote par utilisateur par sondage — non modifiable après soumission
model PollVote {
  id          String       @id @default(cuid())
  poll        Poll         @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  // Poids du vote : 1.0 par défaut. Modifiable par un admin (ex: top user du mois)
  weight      Float        @default(1.0)
  submittedAt DateTime     @default(now())
  answers     PollAnswer[]

  @@unique([pollId, userId])
}

// Réponse d'un utilisateur à une question donnée (contient ses sélections)
model PollAnswer {
  id         String                @id @default(cuid())
  vote       PollVote              @relation(fields: [voteId], references: [id], onDelete: Cascade)
  voteId     String
  question   PollQuestion          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String
  selections PollAnswerSelection[]

  @@unique([voteId, questionId])
}

// Une option sélectionnée dans une réponse, avec rang optionnel
model PollAnswerSelection {
  id       String     @id @default(cuid())
  answer   PollAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  answerId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionId String
  // Pour RANKED_CHOICE : 1 = premier choix, 2 = deuxième… null = sélectionné sans rang
  rank     Int?

  @@unique([answerId, optionId])
}

