generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // User requested NO sqlite
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

// NextAuth Models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  addresses     Address[]
  dietaryPreferences DietaryOption[]
  phoneNumber   String?
  containerBalance Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Address {
  id        String   @id @default(cuid())
  label     String   // e.g. "Home", "Office"
  content   String   // e.g. "123 Main St, Apt 4B, Paris"
  details   String?  // e.g. "Code 1234, Etage 2"
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// App Domain Models

model Menu {
  id        String     @id @default(cuid())
  date      DateTime   @unique
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  orders    Order[]
}

model MenuItem {
  id          String      @id @default(cuid())
  name        String
  description String?
  ingredients String?
  category    ItemCategory @default(MAIN)
  price       Float       @default(0)
  dietaryOptions DietaryOption[]
  spiceLevel  String?     // 'MILD', 'MEDIUM', 'HOT'
  menu        Menu        @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuId      String
  optionGroups OptionGroup[]
  orderItems   OrderItem[]
}

model OptionGroup {
  id          String       @id @default(cuid())
  name        String
  isRequired  Boolean      @default(false)
  allowMultiple Boolean    @default(false)
  maxOptions  Int?
  menuItem    MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  menuItemId  String
  options     OptionItem[]
}

model OptionItem {
  id        String      @id @default(cuid())
  name      String
  description String?
  price     Float       @default(0)
  group     OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
}

enum ItemCategory {
  STARTER
  MAIN
  DESSERT
  DRINK
}

enum DietaryOption {
  VEGETARIAN
  VEGAN
  HALAL
  GLUTEN_FREE
  SPICY
}

model Order {
  id              String      @id @default(cuid())
  user            User        @relation(fields: [userId], references: [id])
  userId          String
  menu            Menu        @relation(fields: [menuId], references: [id])
  menuId          String
  items           OrderItem[]
  deliveryAddress String
  deliveryTime    String?
  notes           String?
  dietaryOption   String?
  status          OrderStatus @default(PENDING)
  stripePaymentId String?
  total           Float       @default(0)
  packaging       Packaging   @default(CARDBOARD)
  isReturningContainer Boolean @default(false)
  containersReturnedCount Int @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

enum OrderStatus {
  PENDING       // Prise en compte
  IN_KITCHEN    // En cuisine (commandes du jour)
  IN_DELIVERY   // En livraison
  DELIVERED     // Livrée (en attente de paiement)
  PAID          // Livrée et payée
  CANCELLED     // Annulée
}

enum Packaging {
  CARDBOARD
  TUPPERWARE
}

model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  item      MenuItem @relation(fields: [itemId], references: [id])
  itemId    String
  selectedOption String? // Deprecated or simple Note?
  selectedOptions Json?   // Stores complex selections { [groupId]: [optionId, optionId] }
}

// Global app settings stored as key-value pairs
// Keys are unique strings; values are JSON-encoded (string, bool, number...)
model AppSetting {
  key       String   @id   // e.g. "tupperware_enabled"
  value     String         // JSON-encoded value, e.g. "true" or "false"
  updatedAt DateTime @updatedAt
}
